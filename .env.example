PORT=3000
NODE_ENV=development

# ─── Banco de Dados ──────────────────────────────────────────────────────────
# SQLite (padrão — zero config):
DB_PATH=./biblioteca.db

# PostgreSQL (comente DB_PATH e descomente DATABASE_URL):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/bibliotecabrasil

# ─── Regras de Negócio ───────────────────────────────────────────────────────
MULTA_DIARIA=0.50
DIAS_EMPRESTIMO_ESTUDANTE=7
DIAS_EMPRESTIMO_PROFESSOR=14
DIAS_EMPRESTIMO_COMUM=7
MAX_EMPRESTIMOS_ESTUDANTE=3
MAX_EMPRESTIMOS_PROFESSOR=5
MAX_EMPRESTIMOS_COMUM=2
MAX_RENOVACOES=2
DIAS_RESERVA=3
DIAS_VALIDADE_MEMBRO=365

# ─── Autenticação JWT ────────────────────────────────────────────────────────
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio_em_producao
JWT_EXPIRES_IN=7d
ADMIN_PASSWORD=troque_em_producao
